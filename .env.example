# Copy to .env and fill in real values. Never commit .env.
# Values below are placeholders for local development only.

# Runtime environment: development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (local Docker Compose service)
POSTGRES_USER=realchat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=realchat
DATABASE_URL=postgresql+asyncpg://realchat:change-me@localhost:5433/realchat

# Redis (local Docker Compose service)
REDIS_URL=redis://localhost:6379/0

# Integration tests: a separate database (created by the Compose init script)
# and Redis database 15, so tests never touch development data.
TEST_DATABASE_URL=postgresql+asyncpg://realchat:change-me@localhost:5433/realchat_test
TEST_REDIS_URL=redis://localhost:6379/15

# Telegram bot (bot process only). Create a development bot with @BotFather and
# paste its token into your local .env. Never commit or share a real token.
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather

# Profile changes: age and gender can each be changed once per this many days (D-019).
PROFILE_CHANGE_COOLDOWN_DAYS=30

# Optional https:// links shown in /help (D-023). Leave empty until they exist.
ANNOUNCEMENT_CHANNEL_URL=
SUPPORT_CONTACT=
